datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  WAITING_CONFIRMATION // 1. Menunggu verifikasi bukti transfer oleh Admin
  PROCESSING           // 2. Pembayaran tervalidasi, diproses & siap konfirmasi WA Admin
  COMPLETED            // 3. Trip/layanan selesai (diverifikasi Admin)
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?   // Nullable jika pakai OAuth (Google)
  role          Role      @default(USER)
  image         String?
  phone         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cart          Cart?
  favorites     Favorite[]
  notifications Notification[]
}

// Model bawaan NextAuth untuk OAuth/Session
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Model Produk (Trip / Outbound / Rental Gear)
model Product {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  category    String     // "TRIP", "OUTBOUND", "GEAR"
  subCategory String?    // Trip: "HIKING", "TEKTOK", "ROCK_CLIMBING", "CAVING" | Outbound: "FLYING_FOX", "RAPELING", "FLYING_FOX_RAPELING"
  price       Float
  description String     @db.Text
  image       String
  stock       Int        @default(10)
  // Menyimpan data lengkap Trip (information, itinerary, essential, rules) atau Outbound (information, rules, gallery)
  metaData    Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
  favorites   Favorite[]
}

// Model Keranjang (Cart)
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  paxCount  Int      @default(1) // Jumlah pax / item
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

// Model Pesanan (Order) - Transfer Manual
model Order {
  id           String      @id @default(cuid())
  userId       String
  totalAmount  Float
  status       OrderStatus @default(WAITING_CONFIRMATION)
  paymentProof String?     @db.Text // Bukti transfer (URL / data URL)
  senderName   String?              // Nama pengirim transfer
  bankName     String?              // Bank / e-wallet pengirim
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

// Model Favorit / Wishlist (Trip, Outbound, Gear jadi satu)
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// Model Notifikasi untuk Customer
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StoreSetting {
  id            String   @id @default("default")
  storeName     String   @default("Alam Memanggil")
  waAdminNumber String   @default("6281292548524")
  bankName      String   @default("Bank Central Asia (BCA)")
  accountNumber String   @default("7445357324")
  accountHolder String   @default("Dimas Alifio")
  updatedAt     DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE // Diskon dalam bentuk % (misal: 5 = 5%)
  FIXED      // Diskon dalam bentuk Rp (misal: 25000 = Rp 25.000)
}

model DiscountCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  minPurchase   Float        @default(0)
  isActive      Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}