# ==========================================
# ALAM MEMANGGIL - ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
# Connection pooling URL (e.g., Supabase Session/Transaction Pooler port 6543 or standard port 5432)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct database connection URL (Used for schema migrations & prisma db push, port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 2. NEXTAUTH CONFIGURATION
# Secret key for encrypting NextAuth tokens (Generate via: npx auth secret)
AUTH_SECRET="your-auth-secret-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# 3. GOOGLE OAUTH PROVIDER (Optional, for Google Sign In / Sign Up)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. SUPABASE CLIENT (Optional, if using Supabase client directly)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

